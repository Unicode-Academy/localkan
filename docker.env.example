# Copy to .env (next to docker-compose.yml) to change how the containers are exposed.

# Address the published ports listen on. 127.0.0.1 = only nginx on this same machine can
# reach them (recommended). Use 0.0.0.0 if the reverse proxy runs on another machine.
BIND_ADDRESS=127.0.0.1

# Host ports. Point your reverse proxy at them:
#   /      -> http://127.0.0.1:FRONTEND_PORT
#   /api/  -> http://127.0.0.1:BACKEND_PORT   (keep the /api prefix; WebSockets included)
FRONTEND_PORT=8080
BACKEND_PORT=8787
