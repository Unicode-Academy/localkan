# MongoDB connection string (required). Atlas example:
# DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/localkan
DATABASE_URL=mongodb://127.0.0.1:27017/localkan

# Optional
# DATABASE_NAME=localkan
# PORT=8787
# HOST=127.0.0.1
# DATA_DIR=.data
# SECURE_COOKIES=1

# Web Push notifications (optional). Without these, keys are generated once and kept in
# MongoDB (collection "settings"). VAPID_SUBJECT is a contact the push services can use.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
