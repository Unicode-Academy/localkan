    "@localkan/protocol": "workspace:*",
    "hono": "^4.13.18",
    "mongodb": "^7.8.0",
    "web-push": "3.6.7",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
